{
  "name": "ingenium-cli",
  "version": "0.0.5",
  "description": "Project scaffolder CLI for Ingenium.",
  "type": "module",
  "bin": {
    "ingenium": "./bin/ingenium.mjs"
  },
  "main": "./src/cli.ts",
  "exports": {
    ".": {
      "types": "./src/cli.ts",
      "import": "./src/cli.ts"
    }
  },
  "files": [
    "src",
    "bin"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "ingenium",
    "cli",
    "scaffold",
    "generator"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.9.2",
    "vitest": "^4.1.8"
  }
}
