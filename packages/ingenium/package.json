{
  "name": "ingenium",
  "version": "0.0.5",
  "description": "Express DX, Hono/Fastify throughput. A Node.js HTTP framework.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "http",
    "express",
    "framework",
    "router",
    "fast"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IngeniumFramework/Ingenium.git",
    "directory": "packages/ingenium"
  },
  "homepage": "https://github.com/IngeniumFramework/Ingenium#readme",
  "bugs": "https://github.com/IngeniumFramework/Ingenium/issues",
  "peerDependencies": {
    "zod": "^4.4.3",
    "ws": "^8.18.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    },
    "ws": {
      "optional": true
    }
  },
  "devDependencies": {
    "zod": "^4.4.3",
    "ws": "^8.18.0",
    "@types/ws": "^8.5.0"
  }
}
