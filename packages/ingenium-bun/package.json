{
  "name": "ingenium-bun",
  "version": "0.0.4",
  "description": "Bun.serve transport adapter for Ingenium.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "keywords": [
    "bun",
    "http",
    "ingenium",
    "transport",
    "adapter"
  ],
  "license": "MIT",
  "peerDependencies": {
    "ingenium": "*"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "vitest": "^2.0.0"
  }
}
